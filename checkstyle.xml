<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Puppy Crawl//DTD Check Configuration 1.3//EN"
          "http://checkstyle.sourceforge.net/dtds/configuration_1_3.dtd">

<!--
  Checkstyle is very configurable.
  http://checkstyle.sf.net (or in your downloaded distribution).
-->

<module name="Checker">
    <!-- Android-shipped main sources only; desktop and tests run on Java 17. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="RegexpSinglelineJava"/>
        <property name="files" value="^(?!.*[\\/](forge-(core|game|ai|gui)[\\/]src[\\/]main|forge-gui-mobile[\\/]src)[\\/]).*$"/>
    </module>
    <module name="TreeWalker">

        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <!-- <property name="processJavadoc" value="false"/> -->
        </module>
        <!-- Stream.toList() only exists from Android 14, so older devices throw NoSuchMethodError. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="androidStreamToList"/>
            <property name="format" value="(?&lt;!Collectors)\.toList\(\)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Stream.toList() is missing on Android 13 and older. Use collect(Collectors.toList())."/>
        </module>
        <!-- Android's regex engine rejects an unescaped } that desktop Java accepts. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="androidRegexBrace"/>
            <property name="format" value="(\bcompile|\.(matches|replaceAll|replaceFirst|split))\(\s*(&quot;[^&quot;\\]*+(?:\\.[^&quot;\\]*+)*+&quot;\s*\+\s*)*&quot;(?:[^&quot;\\}]++|\\.|\})*?(?&lt;!\\)(?&lt;!\{\d{1,9}(,\d{0,9})?)(?&lt;![pPxN]\{[\w=. -]{1,40})(?&lt;![^\\]\[[^\]&quot;]{0,40})(?&lt;!\\Q[^&quot;]{0,40})\}"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Android rejects an unescaped } in a regex. Write \\}."/>
        </module>
        <!-- Android's regex engine rejects a lookbehind with no maximum length, which desktop Java accepts. -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="androidRegexLookbehind"/>
            <property name="format" value="\(\?&lt;[=!](?:\\\\.|\\[^\\]|[^()\[\\&quot;]|\[(?:\\\\.|\\[^\\]|[^\]\\&quot;])*\])*?(?:[*+]|\{\d+,\})"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Android rejects a lookbehind without a maximum length. Use a bounded quantifier."/>
        </module>

    </module>

</module>
