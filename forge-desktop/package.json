    "doctor": "node scripts/doctor.cjs",
    "package": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "electron": "44.4.5"
  }
}
