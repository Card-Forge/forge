{
  "name": "mana-table",
  "productName": "Mana Table",
  "version": "0.1.0-beta.23",
  "description": "A deck workshop and playable match table powered by the Forge rules engine",
  "main": "main.cjs",
  "private": true,
  "author": "proflayton",
  "license": "GPL-3.0-or-later",
  "engines": { "node": ">=22.12.0" },
  "repository": { "type": "git", "url": "https://github.com/proflayton/Mana-Table.git" },
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "test:unit": "node scripts/test-node.cjs unit",
    "test:engine": "node scripts/test-node.cjs engine",
    "test:ui": "playwright test",
    "test:encounters": "playwright test tests/land-play.spec.cjs tests/encounter-ux.spec.cjs",
    "encounter": "node scripts/encounter.cjs",
    "test:smoke": "playwright test tests/startup.spec.cjs tests/desktop.spec.cjs tests/deck-workshop.spec.cjs tests/match.spec.cjs tests/response-skip.spec.cjs tests/card-selection.spec.cjs",
