<?xml version="1.0" encoding="UTF-8"?>
<!--
  Crucible's differential-testing oracle.

  STANDALONE ON PURPOSE - no <parent>, and not listed in the root pom.xml
  <modules>.

  ADR-0002 originally specified naming the root POM as <parent> via
  <relativePath>. That does not work: the root POM uses CI-friendly versioning,
  <version>${revision}</version>, so a child must hardcode the resolved value
  (2.0.15-SNAPSHOT today). That value changes on every upstream release, which
  would make this file break on a sync - exactly the coupling ADR-0001 exists to
  avoid. See the correction in ADR-0002.

  Standalone costs nothing today because the dumpers here use only the JDK. When
  a dumper needs forge-game, add it as an ordinary <dependency> against the
  artifacts produced by `mvn install -DskipTests` at the repository root, with
  the version supplied as -Dforge.version=... rather than hardcoded.

  Build:
      mvn -f crucible/oracle-java/pom.xml test
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>crucible</groupId>
  <artifactId>crucible-oracle</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Crucible Differential Oracle</name>
  <description>
    Generates golden outputs from the Forge Java engine for the Go port to be
    diffed against. Test tooling only - never shipped, never on Crucible's
    execution path (ADR-0002, ADR-0010).
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- 17, matching what upstream's own pom.xml targets. -->
    <maven.compiler.release>17</maven.compiler.release>
  </properties>
</project>
